# Public application origin
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set NEXT_PUBLIC_SITE_URL at BUILD time, then rebuild/redeploy.
# Current production origin: https://recomvia.recomvia.workers.dev

# Replace the current hosted sign-in with production Google OAuth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI engine provider secret; keep server-side only
OPENAI_API_KEY=
# Optional override. Unknown model pricing is stored as unavailable rather than estimated.
OPENAI_VISIBILITY_MODEL=gpt-5.4-mini-2026-03-17

# Replace generic names with the selected payment provider's variables
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=

# Transactional email provider
EMAIL_API_KEY=
EMAIL_FROM=

# Use when migrating from Cloudflare D1 to an external SQL database
DATABASE_URL=
