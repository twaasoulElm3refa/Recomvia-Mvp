# Public application origin
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://recomvia.recomvia.workers.dev
# Set NEXT_PUBLIC_SITE_URL at BUILD time, then rebuild/redeploy.
# Current production origin: https://recomvia.recomvia.workers.dev

# Replace the current hosted sign-in with production Google OAuth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenRouter engine configuration; keep the API key server-side only.
OPENROUTER_API_KEY=
# Required model identifier from OpenRouter, for example openai/gpt-4.1-mini.
OPENROUTER_MODEL=
# Additional DISTINCT provider/model IDs as a JSON array, ordered by preference.
# Essential requires 2 total models; Growth/Pro require 3. No invented defaults.
OPENROUTER_MODELS_JSON=[]
# Per-attempt timeout for search-enabled requests (10000–120000 ms; default 60000).
OPENROUTER_SEARCH_TIMEOUT_MS=60000
# Matching random 32+ character secret on the app and monitor-trigger Worker.
MONITORING_SECRET=
# Set to mock only in automated tests; native OpenRouter transport is then blocked.
AI_TEST_MODE=

# PayPal Sandbox configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRODUCT_ID=
PAYPAL_ESSENTIAL_PLAN_ID=
PAYPAL_GROWTH_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Transactional email provider
EMAIL_API_KEY=
EMAIL_FROM=

# Use when migrating from Cloudflare D1 to an external SQL database
DATABASE_URL=
