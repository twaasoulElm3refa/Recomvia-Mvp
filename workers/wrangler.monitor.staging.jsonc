{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "recomvia-staging-monitor-trigger",
  "main": "monitor-trigger.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // Set to the exact HTTPS origin of the staging app first, then production.
    "RECOMVIA_ORIGIN": "https://recomvia-staging.recomvia.workers.dev"
  }
  // Set MONITORING_SECRET with Wrangler secrets, matching the app's secret.
}

